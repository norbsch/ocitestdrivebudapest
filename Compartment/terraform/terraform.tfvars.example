# Copy to terraform.tfvars and edit before running Terraform.
# Keep credentials and private keys outside this repository.
oci_config_profile = "DEFAULT"
home_region        = "eu-frankfurt-1" # Replace with YOUR tenancy's home region.

# Tenancy root: ocid1.tenancy...; nested parent: ocid1.compartment...
parent_compartment_ocid  = "REPLACE_WITH_PARENT_COMPARTMENT_OR_TENANCY_OCID"
compartment_name         = "OCITestDriveBudapest"
compartment_description = "Resource container for the OCITestDriveBudapest hands-on labs"

freeform_tags = {
  Project = "OCITestDriveBudapest"
}

# Recommended for this disposable lab: fail on name collision and support cleanup.
# False has special adoption/state-removal behavior; see README.md before changing.
enable_compartment_delete = true
