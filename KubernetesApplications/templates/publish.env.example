# Csak az oktato Cloud Shell buildjehez hasznalatos; resztvevonek nem kell.
REGISTRY=fra.ocir.io
OCIR_NAMESPACE=REPLACE_PUBLISHER_TENANCY_NAMESPACE
OCIR_USERNAME=REPLACE_PUBLISHER_DOMAIN_SLASH_USERNAME
APP_REPOSITORY=oci-ai-k8s-streamlit
PROXY_REPOSITORY=oci-ai-k8s-litellm
IMAGE_TAG=workshop-v1
# Public erteket csak jovahagyott nyilvanos repositorykhoz allits.
IMAGE_PULL_AUTH=public
