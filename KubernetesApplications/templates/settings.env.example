# Nem titkos konfiguracio. A script nem hajtja vegre shell-kodkent.
KUBE_CONTEXT=REPLACE_KUBECTL_CONTEXT
NAMESPACE=oci-ai-k8s
# Az oktato images.env fajljabol: python3 tools/workshop.py use-published-images
APP_IMAGE=REPLACE_PUBLISHED_APP_IMAGE
PROXY_IMAGE=REPLACE_PUBLISHED_PROXY_IMAGE
IMAGE_PULL_AUTH=public
# Kizarolag privat kepekhez: tenancy-namespace/domain/username, token nelkul.
OCIR_LOGIN=REPLACE_ONLY_FOR_PRIVATE_IMAGES
NODE_PORT=30080
APP_PUBLIC_HOST=REPLACE_LB_HOSTNAME_OR_IP
APP_PUBLIC_PORT=8080
DB_HOST=REPLACE_POSTGRES_PRIMARY_FQDN
DB_PORT=5432
DB_NAME=litellm_k8s
DB_USER=litellm_k8s
DB_ADMIN=REPLACE_POSTGRES_ADMIN_USERNAME
OCI_REGION=eu-frankfurt-1
OCI_COMPARTMENT_ID=REPLACE_GENAI_COMPARTMENT_OCID
OCI_USER=REPLACE_OCI_USER_OCID
OCI_TENANCY=REPLACE_OCI_TENANCY_OCID
OCI_FINGERPRINT=REPLACE_OCI_API_KEY_FINGERPRINT
OCI_MODEL_ID=oci/cohere.command-a-03-2025
