[Unit]
Description=Streamlit OCI demo application
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/oci-ai-workshop/app
EnvironmentFile=/home/ubuntu/oci-ai-workshop/app/.env
ExecStart=/home/ubuntu/oci-ai-workshop/app/.venv/bin/streamlit run app.py --server.address=0.0.0.0 --server.port=80 --server.headless=true --browser.gatherUsageStats=false
Restart=on-failure
RestartSec=5
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
